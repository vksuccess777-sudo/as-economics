# Copy to .env and fill in. .env is git-ignored — never commit real keys.
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "-latest" alias always points at Google's current stable Flash model, so
# this doesn't silently 404 again next time they retire a dated version.
GEMINI_MODEL=gemini-flash-latest

# Free tier at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Providers are tried in this order, left to right, falling through to the
# next on a 429. A provider missing from this line is never tried, even if
# its key is set. A provider with no key set is skipped automatically.
LLM_FALLBACK_ORDER=groq,gemini,mistral

SYLLABUS_CODE=9708
SYLLABUS_VERSION=2026-2028
SYLLABUS_LEVEL=AS
SYLLABUS_PDF=9708-syllabus.pdf
